# Ignore all input files
*.xlsx
*.xls
*.csv
*.pdf
*.spec
*.docx
*.exe
.env



# Ignore your uploads folder (if that's where test files go)
input_files/
uploads/
venv/
temp_pdf_files/
projects/
build/
dist/

# Ignore Python background files
__pycache__/
# Local runtime data: address book database, packing specs, senders, service code usage, logs
# data/* (not data/): git can't re-include files inside an ignored folder, so ignore its contents instead
data/*
# ...except the carriers' logos, <group id>.png: they ship with the app so a fresh clone has them. Logos dropped in the
# Address Book (logo-<hash>.png) stay on this computer: only its own services list points at them
!data/courier logos/
data/courier logos/*
!data/courier logos/*.png
data/courier logos/logo-*.png
logs/

# Claude Code: personal settings stay on each computer (the shared ones are .claude/settings.json)
.claude/settings.local.json
.pytest_cache/

# Rendered tutorial videos (large MP4s, made outside the code) and any video working folder
Tutorial Videos/
brag-output*/
